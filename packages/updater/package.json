{
  "name": "@kitron/updater",
  "version": "0.1.0",
  "description": "Kitron auto-updater (check/download/verify/install/restart).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "clean": "rm -rf dist" },
  "dependencies": { "@kitron/core": "0.1.0" },
  "devDependencies": { "typescript": "^5.6.3" }
}
