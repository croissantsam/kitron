{
  "name": "@kitron/node",
  "version": "0.1.0",
  "description": "Kitron embedded Node.js backend lifecycle + RPC (RN <-> Node via Kitron IPC).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./backend": { "types": "./dist/backend.d.ts", "default": "./dist/backend.js" }
  },
  "files": ["dist"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "clean": "rm -rf dist" },
  "dependencies": { "@kitron/core": "0.1.0" },
  "devDependencies": { "typescript": "^5.6.3" }
}
