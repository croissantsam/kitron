{
  "name": "@kitron/react",
  "version": "0.1.0",
  "description": "Mainline React renderer for Kitron UI (react-reconciler host, no react-native fork).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "clean": "rm -rf dist" },
  "dependencies": {
    "@kitron/core": "0.1.0",
    "@kitron/ui": "0.1.0",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.33.1",
    "typescript": "^5.6.3"
  }
}
