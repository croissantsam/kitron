{
  "name": "create-kitron",
  "version": "0.1.0",
  "description": "Scaffold a Kitron desktop app: npx create-kitron my-app",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-kitron": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@kitron/cli": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
