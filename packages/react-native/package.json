{
  "name": "@kitron/react-native",
  "version": "0.1.0",
  "description": "react-native API compatible implementation for Kitron (pure-JS libs work; native-code libs need an adapter).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "clean": "rm -rf dist" },
  "dependencies": {
    "@kitron/core": "0.1.0",
    "@kitron/react": "0.1.0",
    "@kitron/ui": "0.1.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.6.3"
  }
}
