{
  "name": "kitron-cli",
  "version": "0.1.0",
  "description": "Kitron CLI: create, dev, build, package, run, doctor. No Chromium/Electron/Vite/TanStack.",
  "type": "module",
  "bin": {
    "kitron": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
