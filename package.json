{
  "name": "kitron",
  "version": "0.1.0",
  "private": true,
  "description": "Build desktop applications with JavaScript, Node.js and native WebViews — without bundling Chromium.",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "pnpm -r typecheck",
    "dev:example": "pnpm --filter ./examples/vanilla dev",
    "doctor": "node packages/cli/dist/bin.js doctor"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}
