{
  "name": "kitron",
  "version": "0.1.2",
  "description": "Desktop runtime for React Native + TypeScript + Node.js apps — powered by native Rust, without Chromium.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kitron": "./cli/dist/kitron.js"
  },
  "files": [
    "cli",
    "runtime",
    "packages",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "instruction.md",
    "!**/node_modules",
    "!**/target",
    "!**/*.a",
    "!**/*.rlib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/croissantlabs/kitron.git"
  },
  "keywords": [
    "react-native",
    "desktop",
    "electron-alternative",
    "rust",
    "node",
    "typescript"
  ],
  "scripts": {
    "kitron": "node cli/src/kitron.ts",
    "typecheck": "tsc --noEmit",
    "test": "bash tests/run.sh",
    "bench": "node bench/run.mjs",
    "doctor": "node cli/src/kitron.ts doctor",
    "prepublishOnly": "npm run typecheck && npm run build:cli",
    "build:rust": "cargo build --release -p kitron-macos --manifest-path runtime/rust/Cargo.toml",
    "build:cli": "tsc -p cli/tsconfig.json",
    "test:rust": "cargo test --manifest-path runtime/rust/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
